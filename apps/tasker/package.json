{
   "name": "@holdmetoit/tasker",
   "version": "1.0.0",
   "private": true,
   "description": "Tasker — Discord task & category bot for HoldMeToIt",
   "type": "module",
   "engines": {
      "node": ">=22.12.0"
   },
   "scripts": {
      "dev": "tsx watch src/index.ts",
      "start": "tsx src/index.ts",
      "build": "echo \"tasker: no build step\"",
      "typecheck": "tsc --noEmit",
      "test": "vitest run",
      "deploy:commands": "tsx src/scripts/deploy-commands.ts",
      "backfill": "tsx src/scripts/backfill-tasker-data.ts"
   },
   "dependencies": {
      "@google/genai": "^2.21.0",
      "@holdmetoit/database": "*",
      "@holdmetoit/discord": "*",
      "@prisma/client": "^6.8.2",
      "chrono-node": "^2.10.1",
      "discord.js": "^14.26.3",
      "dotenv": "^17.4.2",
      "tsx": "^4.19.4",
      "zod": "^3.24.1"
   },
   "devDependencies": {
      "@types/node": "^22.10.0",
      "typescript": "^5.8.3",
      "vitest": "^5.0.3"
   }
}
