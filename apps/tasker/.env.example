# Shared with the web app — the same bot token is used for REST dispatch.
DISCORD_BOT_TOKEN=""
# Optional: register slash commands to this guild on startup (dev only).
DISCORD_GUILD_ID=""
# Prefix commands are optional; MessageContent is a privileged intent.
DISCORD_PREFIX="'"
DISCORD_ENABLE_PREFIX_COMMANDS="true"
DISCORD_REGISTER_COMMANDS_ON_READY="false"

# Same database as @holdmetoit/web (Supabase / local docker compose).
DATABASE_URL=""
DIRECT_URL=""

# Gemini keys are tried in order; 429 exhausts a key, 503 advances the model.
GEMINI_API_KEY=""
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""
GEMINI_MODEL=""

# Public web app URL, used in the "sign in first" prompt.
WEB_APP_URL="http://localhost:3000"

PORT="3001"

# Optional, backfill only: source database containing the legacy Tasker tables.
TASKER_SOURCE_DATABASE_URL=""
