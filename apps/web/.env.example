# Database Connections (Prisma 7.10.1 + @prisma/adapter-pg)
# DATABASE_URL is the pooled runtime connection string (PgBouncer port 6543) consumed by the driver adapter.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public&connect_timeout=30&pool_timeout=30"
# DIRECT_URL is the unpooled direct connection string (port 5432) consumed by Prisma Migrate via prisma.config.ts.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?connect_timeout=30&pool_timeout=30"
# Optional: Path to or PEM content of trusted root CA certificate for strict TLS validation (e.g. Supabase prod-ca-2021.crt)
# DATABASE_SSL_CA=""
# Optional: Set to "true" to require full certificate validation against system CAs for remote databases (defaults to false for Supabase compatibility)
# DATABASE_SSL_REJECT_UNAUTHORIZED="false"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
ALLOW_DEV_BYPASS="false"

AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

DISCORD_GUILD_ID=""
DISCORD_ADMIN_ROLE_IDS=""
DISCORD_BOT_TOKEN=""

DISCORD_FEEDBACK_CHANNEL_ID=""
DISCORD_FEEDBACK_BUG_CHANNEL_ID=""
DISCORD_FEEDBACK_SUGGESTIONS_CHANNEL_ID=""
DISCORD_CHALLENGE_FEEDBACK_CHANNEL_ID="1558594247895289877"

# GitHub issue sync (fine-grained PAT: Issues read/write on the target repo)
GITHUB_TOKEN=""
GITHUB_REPO="Afnanpathan2004/holdmetoit"
GITHUB_ISSUE_LABELS_BUG="bug"
GITHUB_ISSUE_LABELS_ENHANCEMENT="enhancement"
GITHUB_ISSUE_ASSIGNEES=""

# Jira Cloud issue sync (API token from id.atlassian.com)
JIRA_BASE_URL="https://your-site.atlassian.net"
JIRA_EMAIL="bot@example.com"
JIRA_API_TOKEN=""
JIRA_PROJECT_KEY="HMT"
JIRA_ASSIGNEE_ACCOUNT_ID=""
JIRA_LABELS="holdmetoit,feedback"

DEV_DISCORD_IDS='["<snowflake_id_1>", "<snowflake_id_2>"]'

# Yeolpumta (YPT) shared service account (server-only).
# The server authenticates with these to read the group member roster.
YPT_EMAIL=""
YPT_PASSWORD=""
YPT_GROUP_IDS=""

# Bearer key guarding POST /api/v1/ingest/ypt (bot -> web).
YPT_INGEST_API_KEY=""

SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="holdmetoit-bucket"
SUPABASE_EVENT_BANNERS_FOLDER="event-banners"
SUPABASE_PUNISHMENT_PFPS_FOLDER="punishment-pfps"
SUPABASE_FEEDBACK_ATTACHMENTS_FOLDER="feedback-attachments"
 
LOG_LEVEL="info"
NEXT_PUBLIC_LOG_LEVEL="warn"
NEXT_PUBLIC_LOGROCKET_APP_ID="q9morb/holdmeintoit"
NEXT_PUBLIC_APP_RELEASE="0.1.0"
