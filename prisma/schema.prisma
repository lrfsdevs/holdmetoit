// HoldMeToIt — Phase 0 persistence schema (Slice 2)
// Authority: FEATURES.md, HANDOFF.md, AGENTS.md Law L1/L4/L5/L8

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth.js (Discord OAuth) — required adapter models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  /// Discord snowflake (denormalized from Account.providerAccountId for queries / YPT ingest).
  discordId   String?  @unique
  /// YPT numeric user ID
  yptId       String?  @unique
  username    String?
  displayName String?
  role        UserRole @default(PARTICIPANT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  hostedChallenges Challenge[] @relation("ChallengeHost")
  participations ChallengeParticipant[]
  overriddenLogs   DailyStudyLog[]   @relation("LogOverrideAdmin")
  overriddenLogsV2 DailyStudyLogV2[] @relation("LogOverrideAdminV2")
  pardonsIssued  PunishmentRecord[] @relation("PardonAdmin")
  categories         Category[]
  tasks              Task[]
  feedbacks          Feedback[]
  challengeFeedbacks ChallengeFeedback[]
  auditLogsWritten   AuditLog[] @relation("AuditLogsWritten")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Challenge operations (Law L1 — unified Team entity)
// ---------------------------------------------------------------------------

model Challenge {
  id               String          @id @default(cuid())
  title            String
  format           ChallengeFormat
  startAt          DateTime
  endAt            DateTime
  eventBannerUrl   String?
  punishmentPfpUrl String?
  resultsLockedAt  DateTime?

  hostId String?
  host   User?   @relation("ChallengeHost", fields: [hostId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  challengeColor   String?
  isDeleted        Boolean         @default(false)
  deletionTime     DateTime?

  teams            Team[]
  participants     ChallengeParticipant[]
  punishments      PunishmentRecord[]
  tasks            Task[]
  auditLogs        AuditLog[]
  challengeFeedbacks ChallengeFeedback[]

  @@index([hostId])
  @@index([isDeleted, startAt])
}

model Team {
  id          String @id @default(cuid())
  challengeId String
  name        String
  color       String?
  iconEmoji   String?
  mascotUrl   String?
  /// Law L1: Solo = 1, Duo = 2. Null for uncapped squad rosters (TEAM_VS_TEAM).
  maxMembers  Int?
  sortOrder   Int    @default(0)

  isDeleted    Boolean   @default(false)
  deletionTime DateTime?

  challenge    Challenge              @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  participants ChallengeParticipant[]

  @@unique([challengeId, name])
  @@index([challengeId, isDeleted])
}

model ChallengeParticipant {
  id            String            @id @default(cuid())
  challengeId   String
  userId        String
  teamId        String?
  targetSeconds Int               @default(0)
  status        ParticipantStatus @default(NORMAL)

  isWrappedSeen    Boolean @default(false)
  isFeedbackFilled Boolean @default(false)

  enrolledAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)

  dailyStudyLogs   DailyStudyLog[]
  dailyStudyLogsV2 DailyStudyLogV2[]
  punishmentRecords PunishmentRecord[]

  @@unique([challengeId, userId])
  @@index([challengeId])
  @@index([teamId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Study logging (Law L8 — integer seconds; Law L5 — override audit fields)
// ---------------------------------------------------------------------------

model DailyStudyLog {
  id              String   @id @default(cuid())
  participantId   String
  logDate         DateTime @db.Date
  durationSeconds Int      @default(0)
  isLeave         Boolean  @default(false)

  isOverride     Boolean @default(false)
  overrideById   String?
  overrideReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participant  ChallengeParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  overrideBy   User?                @relation("LogOverrideAdmin", fields: [overrideById], references: [id], onDelete: SetNull)

  @@unique([participantId, logDate])
  @@index([participantId])
  @@index([logDate])
}

// ---------------------------------------------------------------------------
// Study logging V2 (YPT Bot Ingestion WIP - clone of DailyStudyLog)
// ---------------------------------------------------------------------------

model DailyStudyLogV2 {
  id              String   @id @default(cuid())
  participantId   String
  logDate         DateTime @db.Date
  durationSeconds Int      @default(0)
  status          String?
  isLeave         Boolean  @default(false)

  isOverride     Boolean @default(false)
  overrideById   String?
  overrideReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participant  ChallengeParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  overrideBy   User?                @relation("LogOverrideAdminV2", fields: [overrideById], references: [id], onDelete: SetNull)

  @@unique([participantId, logDate])
  @@index([participantId])
  @@index([logDate])
}

// ---------------------------------------------------------------------------
// Categorizable Todo List (User-scoped daily and weekly tasks)
// ---------------------------------------------------------------------------

model Category {
  id           String    @id @default(uuid())
  userId       String
  name         String    @db.VarChar(255)
  taskType     TaskType  @default(DAILY)
  sortOrder    Int       @default(0)
  isDeleted    Boolean   @default(false)
  deletionTime DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([userId, name, taskType])
  @@index([userId, taskType, isDeleted])
}

model Task {
  id           String     @id @default(uuid())
  userId       String
  categoryId   String
  challengeId  String?
  title        String     @db.VarChar(255)
  taskType     TaskType
  sortOrder    Int        @default(0)
  isComplete   Boolean    @default(false)
  status       TaskStatus @default(TODO)
  dueDate      DateTime?  @db.Date
  isDeleted    Boolean    @default(false)
  deletionTime DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  completedAt  DateTime?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  challenge Challenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  @@index([userId, taskType, isDeleted])
  @@index([userId, dueDate])
  @@index([categoryId, isDeleted])
  @@index([challengeId, isDeleted])
}

// ---------------------------------------------------------------------------
// Accountability (Law L6 — dual-failure evaluation outcomes)
// ---------------------------------------------------------------------------

model PunishmentRecord {
  id            String  @id @default(cuid())
  challengeId   String
  participantId String

  isPardoned   Boolean @default(false)
  pardonReason String?
  pardonedById String?

  evaluatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  challenge   Challenge            @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  participant ChallengeParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  pardonedBy  User?                @relation("PardonAdmin", fields: [pardonedById], references: [id], onDelete: SetNull)

  @@index([challengeId])
  @@index([participantId])
}

// ---------------------------------------------------------------------------
// Feedback and Bug Reporting
// ---------------------------------------------------------------------------

model Feedback {
  id                 String                @id @default(cuid())
  feedbackNumber     Int                   @default(autoincrement())
  type               FeedbackType
  title              String                @db.VarChar(255)
  description        String                @db.Text
  url                String                @db.VarChar(1024)
  status             FeedbackStatus        @default(OPEN)

  logrocketSessionId String?

  discordStatus      DiscordDeliveryStatus @default(PENDING)
  discordMessageId   String?
  discordChannelId   String?

  userId             String?
  user               User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([feedbackNumber])
  @@index([type])
  @@index([status])
  @@index([discordStatus])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Challenge Post-Event Feedback Survey
// ---------------------------------------------------------------------------

model ChallengeFeedback {
  id                 String   @id @default(cuid())
  challengeId        String
  userId             String

  // Survey Questions (8 community questions)
  consistency        String
  fairnessRating     Int
  trackingPreference String
  teamBattleFeedback String?  @db.Text
  workSchoolHours    String
  soloStyle          String
  soloPunishment     String
  soloIdeas          String?  @db.Text

  // Discord Audit & Timestamps
  discordMessageId   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([challengeId, createdAt(sort: Desc)])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Audit Logging (Law L5 — Append-Only Immutable System Audit Trail)
// ---------------------------------------------------------------------------

model AuditLog {
  id               String   @id @default(cuid())
  challengeId      String?
  actorId          String?
  actorUsername    String
  actorDisplayName String?
  actorImage       String?
  actionType       String   @db.VarChar(64)
  targetEntityId   String
  targetEntityType String   @db.VarChar(64)
  targetEntityName String?  @db.VarChar(255)
  previousValue    Json?
  newValue         Json?
  auditReason      String?  @db.Text
  createdAt        DateTime @default(now())

  challenge Challenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  actor     User?      @relation("AuditLogsWritten", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([challengeId, createdAt(sort: Desc)])
  @@index([actorId])
  @@index([actionType])
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  PARTICIPANT
  ADMIN
  DEV
}

enum ChallengeFormat {
  TEAM_VS_TEAM
  DUOS
  SOLOS
}

enum ParticipantStatus {
  NORMAL
  DEFICIT
  EXCUSED
  PUNISHED
}

enum TaskType {
  DAILY
  WEEKLY
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CROSSED_OUT
}

enum FeedbackType {
  BUG
  ENHANCEMENT
}

enum FeedbackStatus {
  OPEN
  CLOSED
}

enum DiscordDeliveryStatus {
  PENDING
  SENT
  FAILED
}

