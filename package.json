{
   "name": "holdmetoit",
   "version": "0.1.0",
   "private": true,
   "packageManager": "npm@12.2.0",
   "engines": {
      "node": ">=22.12.0"
   },
   "workspaces": [
      "apps/*",
      "packages/*"
   ],
   "scripts": {
      "dev:web": "npm run build -w @holdmetoit/database && npm run dev -w @holdmetoit/web",
      "build:web": "npm run build -w @holdmetoit/database && npm run build -w @holdmetoit/web",
      "start:web": "npm run start -w @holdmetoit/web",
      "test:web": "npm run build -w @holdmetoit/database && npm run test -w @holdmetoit/web",
      "typecheck:web": "npm run build -w @holdmetoit/database && npm run typecheck -w @holdmetoit/web",
      "lint:web": "npm run lint -w @holdmetoit/web",
      "build:ypt-bot": "npm run build -w @holdmetoit/ypt-bot",
      "start:ypt-bot": "npm run start -w @holdmetoit/ypt-bot",
      "test:ypt-bot": "npm run build -w @holdmetoit/database && npm run test -w @holdmetoit/ypt-bot",
      "db:generate": "npm run db:generate -w @holdmetoit/database",
      "db:validate": "npm run db:validate -w @holdmetoit/database",
      "db:migrate": "npm run db:migrate -w @holdmetoit/database",
      "db:migrate:dev": "npm run db:migrate:dev -w @holdmetoit/database",
      "db:migrate:status": "npm run db:migrate:status -w @holdmetoit/database",
      "db:seed": "npm run db:seed -w @holdmetoit/database",
      "db:seed:flags": "npm run db:seed:flags -w @holdmetoit/database",
      "db:seed:pokemon": "npm run db:seed:pokemon -w @holdmetoit/web",
      "backup:db": "npm run backup -w @holdmetoit/ypt-bot",
      "postinstall": "npm run db:generate",
      "format": "prettier --write .",
      "format:check": "prettier --check .",
      "prepare": "husky || true"
   },
   "devDependencies": {
      "husky": "^9.1.7",
      "lint-staged": "^17.6.0",
      "prettier": "^3.9.9"
   }
}
