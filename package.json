{
   "name": "holdmetoit",
   "version": "0.1.0",
   "private": true,
   "packageManager": "npm@12.2.0",
   "engines": {
      "node": ">=22.12.0"
   },
   "scripts": {
      "dev": "next dev",
      "build": "prisma generate && next build",
      "start": "next start",
      "lint": "next lint",
      "typecheck": "prisma generate && tsc --noEmit",
      "test": "vitest run",
      "test:watch": "vitest",
      "db:generate": "prisma generate",
      "db:validate": "DATABASE_URL=postgresql://localhost:5432/holdmetoit prisma validate",
      "db:push": "prisma db push",
      "db:seed": "prisma db seed",
      "db:link-tasks": "tsx --env-file=.env scripts/link-tasks-to-challenge.ts",
      "db:unlock-results": "tsx --env-file=.env scripts/unlock-challenge-results.ts",
      "postinstall": "prisma generate",
      "format": "prettier --write .",
      "format:check": "prettier --check .",
      "prepare": "husky"
   },
   "dependencies": {
      "@auth/prisma-adapter": "^2.9.1",
      "@prisma/client": "^6.8.2",
      "@radix-ui/react-slot": "^1.2.3",
      "@supabase/supabase-js": "^2.117.2",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "logrocket": "^12.4.0",
      "logrocket-react": "^7.0.1",
      "lucide-react": "^0.511.0",
      "next": "^14.2.28",
      "next-auth": "^5.0.0-beta.28",
      "react": "^18.3.1",
      "react-dom": "^18.3.1",
      "sharp": "^0.35.5",
      "tailwind-merge": "^3.3.0",
      "zod": "^4.5.4"
   },
   "devDependencies": {
      "@tailwindcss/postcss": "^4.3.3",
      "@types/node": "^22.15.21",
      "@types/react": "^18.3.23",
      "@types/react-dom": "^18.3.7",
      "autoprefixer": "^10.4.21",
      "eslint": "^8.57.1",
      "eslint-config-next": "^14.2.28",
      "eslint-config-prettier": "^10.1.8",
      "husky": "^9.1.7",
      "lint-staged": "^17.6.0",
      "postcss": "^8.5.4",
      "prettier": "^3.9.9",
      "prisma": "^6.8.2",
      "tailwindcss": "^4.3.3",
      "tailwindcss-animate": "^1.0.7",
      "tsx": "^4.19.4",
      "typescript": "^5.8.3",
      "vitest": "^5.0.3"
   },
   "prisma": {
      "seed": "tsx prisma/seed.ts"
   }
}
