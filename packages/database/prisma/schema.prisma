// HoldMeToIt — Phase 0 persistence schema (Slice 2)
// Authority: FEATURES.md, HANDOFF.md, AGENTS.md Law L1/L4/L5/L8

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth.js (Discord OAuth) — required adapter models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  /// Discord snowflake (denormalized from Account.providerAccountId for queries / YPT ingest).
  discordId   String?  @unique
  /// YPT numeric user ID
  yptId       String?  @unique
  username    String?
  displayName String?
  role        UserRole @default(PARTICIPANT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  hostedChallenges Challenge[] @relation("ChallengeHost")
  participations ChallengeParticipant[]
  overriddenLogs   DailyStudyLog[]   @relation("LogOverrideAdmin")
  pardonsIssued  PunishmentRecord[] @relation("PardonAdmin")
  categories         Category[]
  tasks              Task[]
  feedbacks          Feedback[]
  challengeFeedbacks ChallengeFeedback[]
  auditLogsWritten   AuditLog[] @relation("AuditLogsWritten")
  createdFeatureFlags         FeatureFlag[]         @relation("FeatureFlagCreator")
  featureFlagTargets          FeatureFlagTarget[]   @relation("FeatureFlagTargetUser")
  assignedFeatureFlagTargets  FeatureFlagTarget[]   @relation("FeatureFlagTargetAssigner")
  featureFlagAuditLogs        FeatureFlagAuditLog[] @relation("FeatureFlagAuditActor")
  wallet                      Wallet?
  ledgerTransactions          LedgerTransaction[]
  studyRewardRecords          StudyRewardRecord[]
  wagers                      Wager[]
  pokemonCollection           UserPokemon[]
  createdBanners              PokemonBanner[]       @relation("BannerCreator")
  updatedBanners              PokemonBanner[]       @relation("BannerUpdater")
  bannerPityStates            UserBannerPity[]
  pokemonAcquisitions         PokemonAcquisition[]
  trophyBalance               Int                   @default(0)
  yptClaims                   YptIdentityClaim[]    @relation("UserYptClaims")
  reviewedYptClaims           YptIdentityClaim[]    @relation("AdminYptClaimReviews")
  trophyTransactions          TrophyTransaction[]
  yptConnection               YptConnection?
  yptSyncRuns                 YptSyncRun[]

  @@index([trophyBalance(sort: Desc)])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Challenge operations (Law L1 — unified Team entity)
// ---------------------------------------------------------------------------

model Challenge {
  id               String          @id @default(cuid())
  title            String
  description      String?         @db.Text
  format           ChallengeFormat
  startAt          DateTime
  endAt            DateTime
  eventBannerUrl   String?
  punishmentPfpUrl String?
  resultsLockedAt  DateTime?

  hostId String?
  host   User?   @relation("ChallengeHost", fields: [hostId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  challengeColor   String?
  isDeleted        Boolean         @default(false)
  deletionTime     DateTime?

  teams            Team[]
  participants     ChallengeParticipant[]
  punishments      PunishmentRecord[]
  tasks            Task[]
  auditLogs        AuditLog[]
  challengeFeedbacks ChallengeFeedback[]

  rewardCoins      Int             @default(0)
  isRewardSettled  Boolean         @default(false)
  rewardSettledAt  DateTime?
  isBettingEnabled Boolean         @default(true)
  wagers           Wager[]

  @@index([hostId])
  @@index([isDeleted, startAt])
}

model Team {
  id          String @id @default(cuid())
  challengeId String
  name        String
  color       String?
  iconEmoji   String?
  mascotUrl   String?
  /// Law L1: Solo = 1, Duo = 2. Null for uncapped squad rosters (TEAM_VS_TEAM).
  maxMembers  Int?
  sortOrder   Int    @default(0)

  isDeleted    Boolean   @default(false)
  deletionTime DateTime?

  challenge    Challenge              @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  participants ChallengeParticipant[]
  wagers       Wager[]

  // Active team names are case-insensitively unique per challenge via the
  // partial unique index on (challengeId, lower(name)) WHERE isDeleted = false
  // created in migration 20261029000000_team_active_name_ci_unique.
  @@index([challengeId, isDeleted])
}

model ChallengeParticipant {
  id            String            @id @default(cuid())
  challengeId   String
  userId        String
  teamId        String?
  targetSeconds Int               @default(0)
  plannedLeaveDays Int            @default(0)
  usedLeaveDays    Int            @default(0)
  status        ParticipantStatus @default(NORMAL)

  isWrappedSeen    Boolean @default(false)
  isFeedbackFilled Boolean @default(false)

  isWithdrawn  Boolean   @default(false)
  withdrawalAt DateTime?

  enrolledAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)

  dailyStudyLogs   DailyStudyLog[]
  punishmentRecords PunishmentRecord[]

  @@unique([challengeId, userId])
  @@index([challengeId])
  @@index([challengeId, isWithdrawn])
  @@index([teamId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Study logging (Law L8 — integer seconds; Law L5 — override audit fields)
// ---------------------------------------------------------------------------

model DailyStudyLog {
  id              String   @id @default(cuid())
  participantId   String
  logDate         DateTime @db.Date
  durationSeconds Int      @default(0)
  status          String?
  isLeave         Boolean  @default(false)

  isOverride     Boolean @default(false)
  overrideById   String?
  overrideReason String?

  source             String   @default("MANUAL") @db.VarChar(32)
  externalActivityId String?  @db.VarChar(128)
  yptSubject         String?  @db.VarChar(128)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participant  ChallengeParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  overrideBy   User?                @relation("LogOverrideAdmin", fields: [overrideById], references: [id], onDelete: SetNull)

  @@unique([participantId, logDate])
  @@index([participantId])
  @@index([logDate])
  @@index([participantId, externalActivityId])
}

// ---------------------------------------------------------------------------
// Categorizable Todo List (User-scoped daily and weekly tasks)
// ---------------------------------------------------------------------------

model Category {
  id           String    @id @default(uuid())
  userId       String
  name         String    @db.VarChar(255)
  taskType     TaskType  @default(DAILY)
  sortOrder    Int       @default(0)
  isDeleted    Boolean   @default(false)
  deletionTime DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([userId, name, taskType])
  @@index([userId, taskType, isDeleted])
}

model Task {
  id           String     @id @default(uuid())
  userId       String
  categoryId   String
  challengeId  String?
  title        String     @db.VarChar(255)
  taskType     TaskType
  sortOrder    Int        @default(0)
  isComplete   Boolean    @default(false)
  status       TaskStatus @default(TODO)
  dueDate      DateTime?  @db.Date
  isDeleted    Boolean    @default(false)
  deletionTime DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  completedAt  DateTime?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  challenge Challenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  @@index([userId, taskType, isDeleted])
  @@index([userId, dueDate])
  @@index([categoryId, isDeleted])
  @@index([challengeId, isDeleted])
}

// ---------------------------------------------------------------------------
// Accountability (Law L6 — dual-failure evaluation outcomes)
// ---------------------------------------------------------------------------

model PunishmentRecord {
  id            String  @id @default(cuid())
  challengeId   String
  participantId String

  isPardoned   Boolean @default(false)
  pardonReason String?
  pardonedById String?

  evaluatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  challenge   Challenge            @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  participant ChallengeParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  pardonedBy  User?                @relation("PardonAdmin", fields: [pardonedById], references: [id], onDelete: SetNull)

  @@index([challengeId])
  @@index([participantId])
}

// ---------------------------------------------------------------------------
// Feedback and Bug Reporting
// ---------------------------------------------------------------------------

model Feedback {
  id                 String                @id @default(cuid())
  feedbackNumber     Int                   @default(autoincrement())
  type               FeedbackType
  title              String                @db.VarChar(255)
  description        String                @db.Text
  url                String                @db.VarChar(1024)
  status             FeedbackStatus        @default(OPEN)

  logrocketSessionId String?

  discordStatus      DiscordDeliveryStatus @default(PENDING)
  discordMessageId   String?
  discordChannelId   String?

  githubStatus      GitHubDeliveryStatus @default(PENDING)
  githubIssueNumber Int?
  githubIssueUrl    String?              @db.VarChar(2048)
  githubSyncedAt    DateTime?

  jiraStatus     JiraDeliveryStatus @default(PENDING)
  jiraIssueKey   String?            @db.VarChar(64)
  jiraIssueUrl   String?            @db.VarChar(2048)
  jiraSyncedAt   DateTime?

  userId             String?
  user               User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  attachments        FeedbackAttachment[]

  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([feedbackNumber])
  @@index([type])
  @@index([status])
  @@index([discordStatus])
  @@index([githubStatus])
  @@index([jiraStatus])
  @@index([userId])
}

model FeedbackAttachment {
  id         String                 @id @default(cuid())
  feedbackId String
  url        String                 @db.VarChar(2048)
  path       String                 @db.VarChar(512)
  kind       FeedbackAttachmentKind
  mimeType   String                 @db.VarChar(128)
  sizeBytes  Int
  sortOrder  Int                    @default(0)
  createdAt  DateTime               @default(now())

  feedback   Feedback               @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, path])
  @@index([feedbackId, sortOrder])
}

// ---------------------------------------------------------------------------
// Challenge Post-Event Feedback Survey
// ---------------------------------------------------------------------------

model ChallengeFeedback {
  id                 String   @id @default(cuid())
  challengeId        String
  userId             String

  // Survey Questions (8 community questions)
  consistency        String
  fairnessRating     Int
  trackingPreference String
  teamBattleFeedback String?  @db.Text
  workSchoolHours    String
  soloStyle          String
  soloPunishment     String
  soloIdeas          String?  @db.Text

  // Discord Audit & Timestamps
  discordMessageId   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([challengeId, createdAt(sort: Desc)])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Audit Logging (Law L5 — Append-Only Immutable System Audit Trail)
// ---------------------------------------------------------------------------

model AuditLog {
  id               String   @id @default(cuid())
  challengeId      String?
  actorId          String?
  actorUsername    String
  actorDisplayName String?
  actorImage       String?
  actionType       String   @db.VarChar(64)
  targetEntityId   String
  targetEntityType String   @db.VarChar(64)
  targetEntityName String?  @db.VarChar(255)
  previousValue    Json?
  newValue         Json?
  auditReason      String?  @db.Text
  createdAt        DateTime @default(now())

  challenge Challenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  actor     User?      @relation("AuditLogsWritten", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([challengeId, createdAt(sort: Desc)])
  @@index([actorId])
  @@index([actionType])
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  PARTICIPANT
  ADMIN
  DEV
}

enum ChallengeFormat {
  TEAM_VS_TEAM
  DUOS
  SOLOS
}

enum ParticipantStatus {
  NORMAL
  DEFICIT
  EXCUSED
  PUNISHED
}

enum TaskType {
  DAILY
  WEEKLY
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CROSSED_OUT
}

enum FeedbackType {
  BUG
  ENHANCEMENT
}

enum FeedbackStatus {
  OPEN
  CLOSED
}

enum FeedbackAttachmentKind {
  IMAGE
  VIDEO
}

enum DiscordDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum GitHubDeliveryStatus {
  PENDING
  CREATED
  FAILED
  SKIPPED
}

enum JiraDeliveryStatus {
  PENDING
  CREATED
  FAILED
  SKIPPED
}

// ---------------------------------------------------------------------------
// DevBoard Feature Flags (Self-Hosted Release Controls)
// ---------------------------------------------------------------------------

enum RolloutMode {
  DISABLED
  TARGETED
  GLOBAL
}

model FeatureFlag {
  id          String       @id @default(cuid())
  key         String       @unique
  name        String       @db.VarChar(128)
  description String?      @db.Text
  rolloutMode RolloutMode  @default(DISABLED)
  createdBy   String
  isDeleted   Boolean      @default(false)
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  creator     User         @relation("FeatureFlagCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  targets     FeatureFlagTarget[]
  auditLogs   FeatureFlagAuditLog[]

  @@index([key])
  @@index([isDeleted, rolloutMode])
}

model FeatureFlagTarget {
  flagId      String
  userId      String
  createdBy   String
  createdAt   DateTime     @default(now())

  flag        FeatureFlag  @relation(fields: [flagId], references: [id], onDelete: Cascade)
  user        User         @relation("FeatureFlagTargetUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy  User         @relation("FeatureFlagTargetAssigner", fields: [createdBy], references: [id], onDelete: Restrict)

  @@id([flagId, userId])
  @@index([userId])
}

model FeatureFlagAuditLog {
  id          String       @id @default(cuid())
  flagId      String
  actorId     String?
  action      String       @db.VarChar(64) // CREATED, UPDATED, TOGGLED_MASTER, ROLLOUT_CHANGED, TARGET_ADDED, TARGET_REMOVED, SOFT_DELETED
  oldValue    Json?
  newValue    Json?
  createdAt   DateTime     @default(now())

  flag        FeatureFlag  @relation(fields: [flagId], references: [id], onDelete: Cascade)
  actor       User?        @relation("FeatureFlagAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([flagId, createdAt(sort: Desc)])
  @@index([actorId])
}

// ---------------------------------------------------------------------------
// Virtual Economy (Phase 1: Wallet, Ledger, and Study Rewards)
// ---------------------------------------------------------------------------

enum TransactionType {
  STUDY_REWARD
  CHALLENGE_REWARD
  WAGER_RESERVATION
  WAGER_SETTLEMENT
  WAGER_REFUND
  GACHA_PURCHASE
  TRADE_RESERVATION
  TRADE_SETTLEMENT
  TRADE_REFUND
  ADMIN_ADJUSTMENT
  REVERSAL
}

enum RewardProcessingStatus {
  PROCESSED
  FAILED
  REVOKED
}

model Wallet {
  id                    String              @id @default(cuid())
  userId                String              @unique
  totalBalance          Int                 @default(0)
  reservedBalance       Int                 @default(0)
  rewardProgressSeconds Int                 @default(0)
  lifetimeEarned        Int                 @default(0)
  lifetimeSpent         Int                 @default(0)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          LedgerTransaction[]
  studyRewards          StudyRewardRecord[]
  wagers                Wager[]

  @@index([userId])
}

model LedgerTransaction {
  id                   String             @id @default(cuid())
  walletId             String
  userId               String
  type                 TransactionType
  amount               Int
  totalDelta           Int
  reservedDelta        Int                @default(0)
  sourceType           String?            @db.VarChar(64)
  sourceId             String?            @db.VarChar(128)
  idempotencyKey       String             @unique @db.VarChar(255)
  description          String             @db.VarChar(512)
  metadata             Json?
  relatedTransactionId String?
  createdAt            DateTime           @default(now())

  wallet               Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedTransaction   LedgerTransaction? @relation("TransactionReversal", fields: [relatedTransactionId], references: [id], onDelete: SetNull)
  reversals            LedgerTransaction[] @relation("TransactionReversal")

  @@index([walletId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([type])
  @@index([sourceType, sourceId])
}

model StudyRewardRecord {
  id                         String                 @id @default(cuid())
  userId                     String
  walletId                   String
  studySessionId             String                 @db.VarChar(128)
  sourceType                 String                 @default("DAILY_STUDY_LOG") @db.VarChar(64)
  eligibleSeconds            Int                    @default(0)
  coinsCredited              Int                    @default(0)
  fractionalSecondsConsumed  Int                    @default(0)
  fractionalSecondsRemaining Int                    @default(0)
  status                     RewardProcessingStatus @default(PROCESSED)
  idempotencyKey             String                 @unique @db.VarChar(255)
  ledgerTransactionId        String?
  metadata                   Json?
  createdAt                  DateTime               @default(now())
  processedAt                DateTime               @default(now())

  wallet                     Wallet                 @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user                       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sourceType, studySessionId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([walletId])
}

// ---------------------------------------------------------------------------
// Betting & Wagers (Phase 2)
// ---------------------------------------------------------------------------

enum WagerStatus {
  PENDING
  ACCEPTED
  WON
  LOST
  REFUNDED
  CANCELLED
}

model Wager {
  id                  String      @id @default(cuid())
  challengeId         String
  userId              String
  walletId            String
  teamId              String
  stake               Int
  status              WagerStatus @default(ACCEPTED)
  payout              Int         @default(0)
  settledAt           DateTime?
  ledgerReservationId String?
  ledgerSettlementId  String?
  idempotencyKey      String      @unique @db.VarChar(255)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  challenge           Challenge   @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet              Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  team                Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([challengeId, status])
  @@index([userId, status])
  @@index([walletId])
  @@index([teamId])
}

// ---------------------------------------------------------------------------
// Pokémon Catalogue & Collection (Phase 3)
// ---------------------------------------------------------------------------

enum PokemonRarity {
  NORMAL
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  MYTHICAL
}

enum PokemonAcquisitionSource {
  SEED
  ADMIN_GRANT
  STUDY_MILESTONE
  CHALLENGE_REWARD
  GACHA
  EVENT
  TRADE
}

model PokemonSpecies {
  id             String        @id @default(cuid())
  pokedexNumber  Int           @unique
  name           String        @db.VarChar(128)
  slug           String        @unique @db.VarChar(128)
  rarity         PokemonRarity @default(NORMAL)
  primaryType    String        @db.VarChar(32)
  secondaryType  String?       @db.VarChar(32)
  description    String        @db.Text
  classification String?       @db.VarChar(128)
  imageUrl       String?       @db.VarChar(512)
  spriteUrl      String?       @db.VarChar(512)
  spriteGifUrl   String?       @db.VarChar(512)
  baseHp         Int           @default(0)
  baseAttack     Int           @default(0)
  baseDefense    Int           @default(0)
  specialAttack    Int         @default(0)
  specialDefense   Int         @default(0)
  speed            Int         @default(0)
  baseStatTotal    Int         @default(0)
  heightDecimetres Int?
  weightHectograms Int?
  baseExperience   Int?
  color            String?     @db.VarChar(32)
  captureRate      Int?
  baseHappiness    Int?
  hatchCounter     Int?
  evolvesFromSpeciesId Int?
  evolutionChainId Int?
  growthRateId     Int?
  generation     Int           @default(1)
  isLegendary    Boolean       @default(false)
  isMythical     Boolean       @default(false)
  isBaby         Boolean       @default(false)
  isAvailable    Boolean       @default(true)
  sourceId       String?       @db.VarChar(64)
  referenceUrl   String?       @db.VarChar(512)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  forms          PokemonForm[]
  abilities      PokemonAbility[]
  instances      UserPokemon[]
  featuredBanners PokemonBanner[]       @relation("FeaturedBannerSpecies")
  acquisitions    PokemonAcquisition[]

  @@index([pokedexNumber])
  @@index([rarity])
  @@index([primaryType])
  @@index([generation])
  @@index([isLegendary])
  @@index([isMythical])
  @@index([isAvailable])
  @@index([name])
}

model PokemonForm {
  id                 String         @id @default(cuid())
  speciesId          String
  pokemonId          Int            @unique
  name               String         @db.VarChar(128)
  slug               String         @unique @db.VarChar(128)
  primaryType        String         @db.VarChar(32)
  secondaryType      String?        @db.VarChar(32)
  baseStatTotal      Int            @default(0)
  spritePngUrl       String?        @db.VarChar(512)
  spriteGifUrl       String?        @db.VarChar(512)
  officialArtworkUrl String?        @db.VarChar(512)
  createdAt          DateTime       @default(now())

  species            PokemonSpecies @relation(fields: [speciesId], references: [id], onDelete: Cascade)

  @@index([speciesId])
}

model PokemonAbility {
  id        String         @id @default(cuid())
  speciesId String
  name      String         @db.VarChar(64)
  isHidden  Boolean        @default(false)
  slot      Int

  species   PokemonSpecies @relation(fields: [speciesId], references: [id], onDelete: Cascade)

  @@unique([speciesId, name])
  @@index([speciesId])
}

model UserPokemon {
  id                String                   @id @default(cuid())
  userId            String
  speciesId         String
  obtainedAt        DateTime                 @default(now())
  source            PokemonAcquisitionSource @default(SEED)
  sourceReferenceId String?                  @db.VarChar(128)
  idempotencyKey    String?                  @unique @db.VarChar(255)
  nickname          String?                  @db.VarChar(64)
  isFavorite        Boolean                  @default(false)
  metadata          Json?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  species           PokemonSpecies           @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  acquisitions      PokemonAcquisition[]

  @@index([userId, isFavorite])
  @@index([userId, speciesId])
  @@index([speciesId])
  @@index([obtainedAt])
}

// ---------------------------------------------------------------------------
// Pokémon Acquisition & Banners (Phase 4)
// ---------------------------------------------------------------------------

enum PokemonBannerStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
  DISABLED
}

model PokemonBanner {
  id                String              @id @default(cuid())
  name              String              @db.VarChar(128)
  slug              String              @unique @db.VarChar(128)
  description       String              @db.Text
  bannerType        String              @default("STANDARD") @db.VarChar(64)
  status            PokemonBannerStatus @default(DRAFT)
  startAt           DateTime
  endAt             DateTime?
  pullCost          Int
  allowedQuantities Int[]               @default([1])
  version           Int                 @default(1)
  featuredSpeciesId String?
  rarityRates       Json
  poolFilter        Json?
  pityConfig        Json?
  duplicatePolicy   String              @default("ADD_COPY") @db.VarChar(64)
  createdById       String?
  updatedById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  featuredSpecies   PokemonSpecies?     @relation("FeaturedBannerSpecies", fields: [featuredSpeciesId], references: [id], onDelete: SetNull)
  createdBy         User?               @relation("BannerCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy         User?               @relation("BannerUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  acquisitions      PokemonAcquisition[]
  userPityStates    UserBannerPity[]

  @@index([status, startAt, endAt])
  @@index([slug])
  @@index([featuredSpeciesId])
}

model UserBannerPity {
  id                 String        @id @default(cuid())
  userId             String
  bannerId           String
  pityCount          Int           @default(0)
  guaranteedFeatured Boolean       @default(false)
  lastPullAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  banner             PokemonBanner @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@unique([userId, bannerId])
  @@index([userId])
  @@index([bannerId])
}

model PokemonAcquisition {
  id                  String         @id @default(cuid())
  userId              String
  bannerId            String
  bannerVersion       Int
  speciesId           String
  userPokemonId       String?
  rarity              PokemonRarity
  isFeatured          Boolean        @default(false)
  isDuplicate         Boolean        @default(false)
  duplicateOutcome    String?        @db.VarChar(128)
  costPaid            Int
  ledgerTransactionId String?
  idempotencyKey      String         @unique @db.VarChar(255)
  pityCountBefore     Int            @default(0)
  pityCountAfter      Int            @default(0)
  pityTriggered       Boolean        @default(false)
  metadata            Json?
  createdAt           DateTime       @default(now())

  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  banner              PokemonBanner  @relation(fields: [bannerId], references: [id], onDelete: Restrict)
  species             PokemonSpecies @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  userPokemon         UserPokemon?   @relation(fields: [userPokemonId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([bannerId, createdAt(sort: Desc)])
  @@index([speciesId])
  @@index([ledgerTransactionId])
}

// ---------------------------------------------------------------------------
// Verified YPT Identity (Phase 5)
// ---------------------------------------------------------------------------

enum YptClaimStatus {
  PENDING
  VERIFIED
  REJECTED
  REVOKED
}

model YptIdentityClaim {
  id              String         @id @default(cuid())
  userId          String
  selectedUserId  String?
  yptId           String         @db.VarChar(64)
  yptName         String?        @db.VarChar(128)
  groupId         String?        @db.VarChar(64)
  status          YptClaimStatus @default(PENDING)
  rejectionReason String?        @db.Text
  reviewedById    String?
  reviewedAt      DateTime?
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User           @relation("UserYptClaims", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy      User?          @relation("AdminYptClaimReviews", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([yptId, status])
  @@index([status, createdAt(sort: Desc)])
}

enum YptConnectionStatus {
  NOT_CONNECTED
  CONNECTING
  CONNECTED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SYNC_ERROR
  REAUTHENTICATION_REQUIRED
}

model YptConnection {
  id                    String              @id @default(cuid())
  userId                String              @unique
  yptUserId             String              @db.VarChar(64)
  yptNickname           String?             @db.VarChar(128)
  status                YptConnectionStatus @default(NOT_CONNECTED)
  lastSyncedAt          DateTime?
  lastSyncError         String?             @db.Text
  metadata              Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncRuns              YptSyncRun[]

  @@index([yptUserId])
}

model YptSyncRun {
  id                      String        @id @default(cuid())
  connectionId            String
  userId                  String
  status                  String        @db.VarChar(32)
  startedAt               DateTime      @default(now())
  completedAt             DateTime?
  importedDurationSeconds Int           @default(0)
  eligibleDurationSeconds Int           @default(0)
  coinsCredited           Int           @default(0)
  errorCode               String?       @db.VarChar(64)
  errorMessage            String?       @db.Text
  createdAt               DateTime      @default(now())

  connection              YptConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// ypt-bot job run logging (CronLog) and per-member change history
// ---------------------------------------------------------------------------

enum CronJobStatus {
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

model CronLog {
  id           String        @id @default(cuid())
  jobName      String        @db.VarChar(64)
  runId        String        @db.VarChar(64) @unique
  trigger      String        @db.VarChar(32)
  status       CronJobStatus @default(RUNNING)
  challengeId  String?       @db.VarChar(64)
  startedAt    DateTime      @default(now())
  finishedAt   DateTime?
  durationMs   Int?
  summary      Json?
  errorCode    String?       @db.VarChar(64)
  errorMessage String?       @db.Text
  createdAt    DateTime      @default(now())

  @@index([jobName, startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
  @@index([challengeId, startedAt(sort: Desc)])
  @@index([startedAt])
}

// ---------------------------------------------------------------------------
// Trophy Ranking System (Phase 5)
// ---------------------------------------------------------------------------

enum TrophyTransactionType {
  CHALLENGE_WIN
  CHALLENGE_LOSS
  ADMIN_ADJUSTMENT
  REVERSAL
  SEASON_RESET
}

model TrophyTransaction {
  id                   String                @id @default(cuid())
  userId               String
  groupId              String?               @db.VarChar(64)
  amount               Int
  balanceAfter         Int
  type                 TrophyTransactionType
  sourceType           String?               @db.VarChar(64)
  sourceId             String?               @db.VarChar(128)
  idempotencyKey       String?               @unique @db.VarChar(255)
  description          String                @db.VarChar(512)
  metadata             Json?
  relatedTransactionId String?
  createdAt            DateTime              @default(now())

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedTransaction   TrophyTransaction?    @relation("TrophyReversal", fields: [relatedTransactionId], references: [id], onDelete: SetNull)
  reversals            TrophyTransaction[]   @relation("TrophyReversal")

  @@index([userId, createdAt(sort: Desc)])
  @@index([type])
  @@index([sourceType, sourceId])
  @@index([groupId])
}
